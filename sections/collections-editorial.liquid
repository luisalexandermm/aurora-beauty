<section id="colecciones">
  <div class="wrap">
    <div class="collections-head reveal">
      <div><span class="eyebrow">{{ section.settings.eyebrow | default: "Colecciones destacadas" }}</span><h2 style="margin-top:8px;">{{ section.settings.heading | default: "Descubre lo mejor para ti" }}</h2></div>
      <p>{{ section.settings.text | default: "Colecciones pensadas para cada necesidad, cada momento y cada versión de ti." }}</p>
    </div>
    <div class="coll-grid reveal">
      {% for block in section.blocks %}
        {% assign col = block.settings.collection %}
        <a href="{{ col.url | default: '#' }}" class="coll-card" style="background:{% if block.settings.image != blank %}url('{{ block.settings.image | image_url: width: 800 }}') center/cover{% elsif col != blank and col.image != blank %}url('{{ col.image | image_url: width: 800 }}') center/cover{% else %}linear-gradient(140deg,{{ block.settings.color_from | default: '#e8c7c9' }},{{ block.settings.color_to | default: '#c78f82' }}){% endif %};" {{ block.shopify_attributes }}>
          <div>
            <h3>{{ block.settings.title | default: col.title }}</h3>
            <p>{{ block.settings.text }}</p>
            <span class="go">Descubrir →</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Colecciones editoriales",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "Colecciones destacadas" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Descubre lo mejor para ti" },
    { "type": "textarea", "id": "text", "label": "Párrafo", "default": "Colecciones pensadas para cada necesidad, cada momento y cada versión de ti." }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Tarjeta de colección",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "title", "label": "Título (si no usas colección)" },
        { "type": "text", "id": "text", "label": "Descripción corta" },
        { "type": "image_picker", "id": "image", "label": "Imagen de fondo (opcional)" },
        { "type": "color", "id": "color_from", "label": "Color degradado inicio", "default": "#E8C7C9" },
        { "type": "color", "id": "color_to", "label": "Color degradado fin", "default": "#C78F82" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "collection_card", "settings": { "title": "Rutina Glow", "text": "Ilumina y revitaliza tu piel.", "color_from": "#E8C7C9", "color_to": "#C78F82" } },
      { "type": "collection_card", "settings": { "title": "Anti Edad", "text": "Fórmulas que cuidan y previenen.", "color_from": "#D8B89C", "color_to": "#A7A29D" } },
      { "type": "collection_card", "settings": { "title": "Hidratación Profunda", "text": "Nutrición intensa para tu piel.", "color_from": "#F5DCDD", "color_to": "#D8B89C" } }
    ]
  },
  "presets": [{ "name": "Colecciones editoriales" }]
}
{% endschema %}
