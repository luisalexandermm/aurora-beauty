<section class="wrap" style="padding-top:150px;">
  <div class="section-head reveal">
    <div><span class="eyebrow">Colección</span><h2 style="margin-top:8px;">{{ collection.title }}</h2></div>
  </div>

  {% if collection.description != blank %}
    <div style="font-family:'Inter',sans-serif; font-size:13.5px; color:var(--ink-soft); max-width:640px; margin:-30px 0 40px;">{{ collection.description }}</div>
  {% endif %}

  {% paginate collection.products by 24 %}
    {% if collection.products.size > 0 %}
      <div class="prod-grid reveal">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    {% else %}
      <p style="font-family:'Inter',sans-serif; font-size:13px; color:var(--ink-soft);">Todavía no hay productos en esta colección.</p>
    {% endif %}

    {% if paginate.pages > 1 %}
      <div class="cat-load-more" style="gap:14px;">
        {% if paginate.previous %}<a href="{{ paginate.previous.url }}" class="btn btn-outline">← Anterior</a>{% endif %}
        {% if paginate.next %}<a href="{{ paginate.next.url }}" class="btn btn-outline">Siguiente →</a>{% endif %}
      </div>
    {% endif %}
  {% endpaginate %}
</section>
