<section id="categorias">
  <div class="wrap">
    <div class="section-head reveal">
      <div><span class="eyebrow">{{ section.settings.eyebrow | default: "Categorías" }}</span><h2 style="margin-top:8px;">{{ section.settings.heading | default: "Explora Aurora" }}</h2></div>
      {% if section.settings.link_url != blank %}<a class="section-link" href="{{ section.settings.link_url }}">Ver todas →</a>{% endif %}
    </div>
    <div class="cat-row reveal">
      {% for block in section.blocks %}
        {% assign col = block.settings.collection %}
        <a href="{{ col.url | default: '#' }}" class="cat-card" {{ block.shopify_attributes }}>
          <div class="img">
            {% if block.settings.image != blank %}
              <img class="cat-illustration" src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.title | default: col.title }}" loading="lazy">
            {% elsif block.settings.default_asset != blank %}
              <img class="cat-illustration" src="{{ block.settings.default_asset | asset_url }}" alt="{{ block.settings.title | default: col.title }}" loading="lazy">
            {% elsif col != blank and col.image != blank %}
              <img class="cat-illustration" src="{{ col.image | image_url: width: 500 }}" alt="{{ block.settings.title | default: col.title }}" loading="lazy">
            {% endif %}
          </div>
          <h4>{{ block.settings.title | default: col.title }}</h4>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categorías",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "Categorías" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Explora Aurora" },
    { "type": "url", "id": "link_url", "label": "Enlace de 'ver todas'" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "title", "label": "Título (si no usas colección)" },
        { "type": "image_picker", "id": "image", "label": "Imagen (opcional, prioridad sobre la de la colección)" },
        { "type": "text", "id": "default_asset", "label": "Nombre de imagen por defecto del tema (avanzado)", "info": "Ej: category-skincare.webp — déjalo así si no subes tu propia imagen." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "category", "settings": { "title": "Skincare", "default_asset": "category-skincare.webp" } },
      { "type": "category", "settings": { "title": "Maquillaje", "default_asset": "category-maquillaje.webp" } },
      { "type": "category", "settings": { "title": "Cabello", "default_asset": "category-cabello.webp" } },
      { "type": "category", "settings": { "title": "Belleza Facial", "default_asset": "category-belleza-facial.webp" } },
      { "type": "category", "settings": { "title": "Perfumería", "default_asset": "category-perfumeria.webp" } },
      { "type": "category", "settings": { "title": "Accesorios", "default_asset": "category-accesorios.webp" } }
    ]
  },
  "presets": [{ "name": "Categorías" }]
}
{% endschema %}
