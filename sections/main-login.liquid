<section class="wrap" style="padding-top:150px; padding-bottom:100px; max-width:420px;">
  <div class="section-head reveal"><div><h2>Iniciar sesión</h2></div></div>
  {% form 'customer_login' %}
    {% if form.errors %}
      <p style="font-family:'Inter',sans-serif; color:#B33; font-size:12.5px; margin-bottom:14px;">{{ form.errors | default_errors }}</p>
    {% endif %}
    <div class="checkout-field"><label>Correo electrónico</label><input type="email" name="customer[email]" required></div>
    {% if form.password_needed %}
      <div class="checkout-field"><label>Contraseña</label><input type="password" name="customer[password]" required></div>
    {% endif %}
    <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center; margin-top:10px;">Entrar →</button>
  {% endform %}
  <p style="font-family:'Inter',sans-serif; font-size:12.5px; color:var(--ink-soft); margin-top:18px;">
    ¿No tienes cuenta? <a href="{{ routes.account_register_url }}" style="color:var(--rosegold);">Regístrate aquí</a>
  </p>
</section>
