<section id="{{ section.settings.anchor | default: section.id }}"{% if section.settings.alt_background %} style="background:var(--pearl-2);"{% endif %}>
  <div class="wrap">
    <div class="section-head reveal">
      <div><span class="eyebrow">{{ section.settings.eyebrow | default: "Categoría" }}</span><h2 style="margin-top:8px;">{{ section.settings.heading }}</h2></div>
      <a class="section-link" href="{{ section.settings.link_url | default: '#top' }}">{{ section.settings.link_label | default: "Volver arriba ↑" }}</a>
    </div>

    {% assign col = section.settings.collection %}
    {% assign limit = section.settings.initial_count | default: 8 %}
    {% assign showcase_cap = 24 %}

    {% if col != blank %}
      <div class="prod-grid reveal">
        {% for product in col.products limit: showcase_cap %}
          {% if forloop.index0 < limit %}
            {% render 'product-card', product: product %}
          {% else %}
            <div class="is-hidden" data-extra-product data-group="{{ section.id }}">
              {% render 'product-card', product: product %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
      {% assign shown_max = col.products_count | at_most: showcase_cap %}
      {% if shown_max > limit %}
        <div class="cat-load-more">
          <button type="button" class="btn btn-outline magnetic" data-load-more="{{ section.id }}">Ver los {{ shown_max | minus: limit }} restantes →</button>
        </div>
      {% endif %}
      {% if col.products_count > showcase_cap %}
        <div class="cat-load-more">
          <a href="{{ col.url }}" class="section-link">Ver los {{ col.products_count }} productos de {{ col.title }} →</a>
        </div>
      {% endif %}
    {% else %}
      <p style="font-family:'Inter',sans-serif; font-size:13px; color:var(--ink-soft);">
        Elige una colección para esta sección desde el editor de temas.
      </p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Vitrina de colección",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Identificador de ancla (opcional)", "info": "Ej: skincare — para enlaces internos tipo #skincare" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "Categoría" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Nombre de la categoría" },
    { "type": "url", "id": "link_url", "label": "Enlace del botón superior derecho" },
    { "type": "text", "id": "link_label", "label": "Texto del botón superior derecho", "default": "Volver arriba ↑" },
    { "type": "collection", "id": "collection", "label": "Colección a mostrar" },
    { "type": "range", "id": "initial_count", "label": "Productos visibles antes de 'ver más'", "min": 4, "max": 16, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "alt_background", "label": "Fondo alterno (gris claro)", "default": false }
  ],
  "presets": [{ "name": "Vitrina de colección" }]
}
{% endschema %}
