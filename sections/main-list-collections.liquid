<section class="wrap" style="padding-top:150px; padding-bottom:100px;">
  <div class="section-head reveal">
    <div><span class="eyebrow">Explora</span><h2 style="margin-top:8px;">Todas las categorías</h2></div>
  </div>
  <div class="cat-row reveal">
    {% for collection in collections %}
      {% unless collection.handle == 'frontpage' %}
        <a href="{{ collection.url }}" class="cat-card">
          <div class="img">
            {% if collection.image %}
              <img class="cat-illustration" src="{{ collection.image | image_url: width: 500 }}" alt="{{ collection.title }}" loading="lazy">
            {% endif %}
          </div>
          <h4>{{ collection.title }}</h4>
        </a>
      {% endunless %}
    {% endfor %}
  </div>
</section>
