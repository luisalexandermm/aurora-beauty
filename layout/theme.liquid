<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#FCFBFA">
  <link rel="canonical" href="{{ canonical_url }}">

  <title>
    {{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}
  </title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Manrope:wght@400;500;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">

  <script>
    window.AuroraSettings = { whatsapp: {{ settings.whatsapp_number | default: '573145312045' | json }} };
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  {{ content_for_header }}
</head>
<body class="template-{{ request.page_type | handleize }}">
  <a class="skip-to-content" href="#MainContent">Saltar al contenido</a>

  <div class="cursor-dot" id="cursorDot"></div>
  <div class="cursor-ring" id="cursorRing"></div>

  {% section 'announcement-bar' %}
  {% section 'header' %}
  {% render 'mobile-drawer' %}
  {% render 'search-panel' %}

  <main id="MainContent">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}
  {% render 'quick-view-modal' %}

  <div class="toast" id="toast"></div>
</body>
</html>
